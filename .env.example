# Only needed for real voices. The demo runs offline with VOICE_PROVIDER=mock.
# Copy to .env (git-ignored) and fill in your own values. Never commit real keys.
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=your-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_MODEL_ID=eleven_v3
TTS_LANGUAGE=en

# Chrome channel used by the headless renderer
CHROME_CHANNEL=chrome
